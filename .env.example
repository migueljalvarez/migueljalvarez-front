# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
# Los secretos se leen en ejecución (no se compilan dentro del build). En producción puedes usar estos
# mismos nombres o su versión con prefijo NUXT_ (p. ej. NUXT_RESEND_API_KEY, NUXT_ADMIN_EMAIL), que tiene prioridad.

# Sitio
NUXT_PUBLIC_BASE_URL=http://localhost:3000

# Correo de contacto (Resend)
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=

# Firebase Admin (servidor). Se reemplazará por Supabase (ver plan en Notion)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Dashboard actual (login provisional; se reemplaza por Supabase Auth)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Cadena aleatoria larga para firmar la sesión (p. ej. `openssl rand -base64 48`)
ADMIN_SESSION_SECRET=
