# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# Sitio
NUXT_PUBLIC_BASE_URL=http://localhost:3333
# Puerto del servidor de desarrollo (opcional; por defecto 3333). Mantén NUXT_PUBLIC_BASE_URL en sincronía.
NUXT_DEV_PORT=3333

# Correo de contacto (Resend)
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=

# Firebase Admin (servidor). Se reemplazará por Supabase (ver plan en Notion)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase cliente (público)
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# Dashboard actual (login provisional; se reemplaza por Supabase Auth)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Cadena aleatoria larga para firmar la sesión (p. ej. `openssl rand -base64 48`)
ADMIN_SESSION_SECRET=
