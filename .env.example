# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
# Los secretos se leen en ejecución (no se compilan dentro del build). En producción puedes usar estos
# mismos nombres o su versión con prefijo NUXT_ (p. ej. NUXT_RESEND_API_KEY, NUXT_API_BASE_URL), que tiene prioridad.
# Las líneas "Ejemplo:" son solo orientación con valores inventados; deja las variables vacías si no las usas.

# ── Sitio ────────────────────────────────────────────────────────────────────────────────────────
# URL pública del sitio, sin barra final. Se lee al COMPILAR (en Netlify, definirla antes del deploy).
# Local: http://localhost:3000 (o el puerto que uses). Producción: https://www.migueljalvarez.com (el dominio principal de Netlify; el
# login del panel compara Origin con ella: si no coincide con la dirección real, da 403)
# Con una URL local el robots.txt bloquea todo (a propósito).
NUXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Titular legal (pie, Términos y Política de privacidad) ──────────────────────────────────────
# Datos públicos por diseño, pero van aquí (variables de Netlify/servidor), nunca en el código.
# Si falta alguno, esa parte del texto se omite.
# Ejemplo: NUXT_PUBLIC_LEGAL_NAME="Nombre Apellido Apellido"
NUXT_PUBLIC_LEGAL_NAME=
# Solo CC o NIT. Ejemplo: CC
NUXT_PUBLIC_LEGAL_ID_TYPE=
# Número sin puntos ni espacios. Ejemplo: 1234567890
NUXT_PUBLIC_LEGAL_ID_NUMBER=
# Correo para temas de privacidad y datos. Ejemplo: privacidad@example.com
NUXT_PUBLIC_LEGAL_EMAIL=
# Ciudad (y país). Ejemplo: "Medellín, Colombia"
NUXT_PUBLIC_LEGAL_CITY=

# ── Correo de contacto (Resend) ──────────────────────────────────────────────────────────────────
# Clave de API de Resend. Ejemplo: re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=
# Remitente con un dominio verificado en Resend. Ejemplo: "Mi sitio <contacto@example.com>"
MAIL_FROM=
# Dónde recibes los mensajes del formulario. Ejemplo: tu-correo@example.com
MAIL_TO=

# ── API de contenido (migueljalvarez-api) ────────────────────────────────────────────────────────
# Portafolio, redes, políticas y Sobre mí que se gestionan desde el panel. El panel /admin también habla con
# esta API (proxy en server/api/admin/[...path].ts): sin ella el panel muestra "no conectado". La autenticación
# (contraseña + TOTP) vive en la API; el sitio no guarda credenciales de administrador.
# Vacío = sin API: el sitio usa su contenido de respaldo (constants/ y data/).
# Dirección base, sin /api ni barra final. Local: http://localhost:4000. Producción: https://api.migueljalvarez.com
NUXT_API_BASE_URL=
# Solo si la API está detrás de Cloudflare Access: credenciales del token de servicio.
# Ejemplo: NUXT_API_ACCESS_CLIENT_ID=xxxxxxxx.access
NUXT_API_ACCESS_CLIENT_ID=
NUXT_API_ACCESS_CLIENT_SECRET=
# Clave compartida para guardar los leads del formulario de contacto: debe coincidir con INTAKE_API_KEY de la API
# (32 caracteres o más). Sin ella (o sin API) el formulario solo envía el correo.
NUXT_INTAKE_API_KEY=
